# Server
PORT=8000
NODE_ENV=development

# Postgres (docker compose -f docker-compose.dev.yml up -d gives you this one)
DATABASE_URL=postgresql://roomie:roomie@localhost:5432/roomie

# Firebase Admin, used to verify Google sign-in tokens from the apps.
# Use ONE of these:
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Non-Cornell emails allowed to sign in (comma-separated), e.g. an App Store reviewer account
EMAIL_ALLOWLIST=

# Local development only: accept "Authorization: Bearer dev:<netid>" without Firebase.
# Ignored when NODE_ENV=production.
AUTH_DEV_BYPASS=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Set to true to log every SQL query
PRISMA_LOG_QUERIES=false
