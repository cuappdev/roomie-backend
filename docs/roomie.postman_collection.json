{
  "info": {
    "name": "Roomie API (local)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Every Roomie MVP endpoint. Start the server (`npm run dev`) and click **Run collection** to go through the whole flow, or send requests one by one top to bottom (later requests reuse IDs saved by earlier ones).\n\nAuth uses the dev bypass: `Bearer dev:{{netid}}`. Requests marked as the roommate use `dev:{{roommateNetid}}`.\n\nTo poke at the seeded demo house (`npm run db:seed`), set `netid` to `lk452` and `keepNetids` to `true`, then use `houseId` 1."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "dev:{{netid}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "netid",
      "value": "lk452"
    },
    {
      "key": "roommateNetid",
      "value": "sc2291"
    },
    {
      "key": "keepNetids",
      "value": ""
    },
    {
      "key": "myId",
      "value": ""
    },
    {
      "key": "roommateId",
      "value": ""
    },
    {
      "key": "houseId",
      "value": "1"
    },
    {
      "key": "inviteCode",
      "value": ""
    },
    {
      "key": "inviteId",
      "value": ""
    },
    {
      "key": "extraInviteId",
      "value": ""
    },
    {
      "key": "choreId",
      "value": ""
    },
    {
      "key": "assignmentId",
      "value": ""
    },
    {
      "key": "otherAssignmentId",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "roommateItemId",
      "value": ""
    },
    {
      "key": "today",
      "value": ""
    },
    {
      "key": "weekEnd",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 \u00b7 Start",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"database connected\", () => pm.expect(pm.response.json().database).to.eql('connected'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// New NetIDs every run so the collection can be re-run against the same DB.",
                  "// To explore the seeded demo house instead, set netid to lk452 and skip this folder.",
                  "if (pm.info.iteration === 0 && !pm.collectionVariables.get('keepNetids')) {",
                  "  const n = Math.floor(100000 + Math.random() * 899999);",
                  "  pm.collectionVariables.set('netid', 'pm' + n);",
                  "  pm.collectionVariables.set('roommateNetid', 'pr' + n);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1 \u00b7 Auth & me",
      "item": [
        {
          "name": "Login (creates account first time)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('myId', body.user.id);",
                  "pm.test(\"is a new user with no house\", () => { pm.expect(body.isNewUser).to.be.true; pm.expect(body.house).to.be.null; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Real apps send the Firebase ID token from Google sign-in. Locally, `Bearer dev:<netid>` works when AUTH_DEV_BYPASS=true. Returns 201 the first time, 200 after."
          }
        },
        {
          "name": "Get me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            }
          }
        },
        {
          "name": "Update me (name, presence)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"name updated\", () => pm.expect(pm.response.json().user.name).to.eql('Postman Tester'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"major\": \"Computer Science\",\n  \"presence\": \"HOME\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Roommate logs in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('roommateId', pm.response.json().user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "dev:{{roommateNetid}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2 \u00b7 Houses",
      "item": [
        {
          "name": "Create house (+ invite roommate)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const { house } = pm.response.json();",
                  "pm.collectionVariables.set('houseId', house.id);",
                  "pm.collectionVariables.set('inviteCode', house.inviteCode);",
                  "pm.test(\"roommate invite is pending\", () => pm.expect(house.pendingInvites).to.have.lengthOf(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/houses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "houses"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"The Linden Loft\",\n  \"color\": \"#8B5A34\",\n  \"livingType\": \"OFF_CAMPUS\",\n  \"address\": \"112 Linden Ave\",\n  \"unit\": \"Apt 3B\",\n  \"leaseEndsOn\": \"2027-05-31\",\n  \"inviteNetids\": [\n    \"{{roommateNetid}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get house",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/houses/{{houseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "houses",
                "{{houseId}}"
              ]
            }
          }
        },
        {
          "name": "Update house settings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/houses/{{houseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "houses",
                "{{houseId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"features\": [\n    \"CHORES\",\n    \"SHOPPING\",\n    \"BILLS\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Invite more NetIDs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('extraInviteId', pm.response.json().house.pendingInvites.find(i => i.netid === 'zz123').id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/houses/{{houseId}}/invites",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "houses",
                "{{houseId}}",
                "invites"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"netids\": [\n    \"zz123\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Revoke an invite",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/houses/{{houseId}}/invites/{{extraInviteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "houses",
                "{{houseId}}",
                "invites",
                "{{extraInviteId}}"
              ]
            }
          }
        },
        {
          "name": "Roommate sees pending invite",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const invites = pm.response.json().pendingInvites;",
                  "pm.test(\"has one invite\", () => pm.expect(invites).to.have.lengthOf(1));",
                  "pm.collectionVariables.set('inviteId', invites[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "dev:{{roommateNetid}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Roommate accepts invite",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"now 2 members\", () => pm.expect(pm.response.json().house.members).to.have.lengthOf(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/invites/{{inviteId}}/accept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invites",
                "{{inviteId}}",
                "accept"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "dev:{{roommateNetid}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Join by invite code (example: fails, you're already in a house)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/houses/join",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "houses",
                "join"
              ]
            },
            "description": "Someone without a house sends this with the code shown on the house setup screen. Codes are case-insensitive.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inviteCode\": \"{{inviteCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "New invite code (owner only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/houses/{{houseId}}/invite-code",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "houses",
                "{{houseId}}",
                "invite-code"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3 \u00b7 Chores",
      "item": [
        {
          "name": "Create chore with rotation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const { chore } = pm.response.json();",
                  "pm.collectionVariables.set('choreId', chore.id);",
                  "pm.test(\"coming up has 3 turns\", () => pm.expect(chore.comingUp).to.have.lengthOf(3));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Today and a week from today, in local time (YYYY-MM-DD)",
                  "const fmt = (d) => d.toLocaleDateString('en-CA');",
                  "const today = new Date();",
                  "pm.collectionVariables.set('today', fmt(today));",
                  "pm.collectionVariables.set('weekEnd', fmt(new Date(today.getTime() + 6 * 86400000)));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/houses/{{houseId}}/chores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "houses",
                "{{houseId}}",
                "chores"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Take out trash & recycling\",\n  \"frequency\": \"EVERY_OTHER_DAY\",\n  \"startsOn\": \"{{today}}\",\n  \"rotation\": [\n    {{myId}},\n    {{roommateId}}\n  ],\n  \"allowSwaps\": true,\n  \"reminderHour\": 18\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List chores",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/houses/{{houseId}}/chores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "houses",
                "{{houseId}}",
                "chores"
              ]
            }
          }
        },
        {
          "name": "Get chore",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/houses/{{houseId}}/chores/{{choreId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "houses",
                "{{houseId}}",
                "chores",
                "{{choreId}}"
              ]
            }
          }
        },
        {
          "name": "This week's turns (everyone)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const a = pm.response.json().assignments;",
                  "pm.test(\"has turns\", () => pm.expect(a.length).to.be.above(1));",
                  "pm.collectionVariables.set('assignmentId', a[0].id);",
                  "pm.collectionVariables.set('otherAssignmentId', a[1].id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Today and a week from today, in local time (YYYY-MM-DD)",
                  "const fmt = (d) => d.toLocaleDateString('en-CA');",
                  "const today = new Date();",
                  "pm.collectionVariables.set('today', fmt(today));",
                  "pm.collectionVariables.set('weekEnd', fmt(new Date(today.getTime() + 6 * 86400000)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/houses/{{houseId}}/chore-assignments?from={{today}}&to={{weekEnd}}&includeOverdue=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "houses",
                "{{houseId}}",
                "chore-assignments"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "{{today}}"
                },
                {
                  "key": "to",
                  "value": "{{weekEnd}}"
                },
                {
                  "key": "includeOverdue",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "My chores today (Home)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Today and a week from today, in local time (YYYY-MM-DD)",
                  "const fmt = (d) => d.toLocaleDateString('en-CA');",
                  "const today = new Date();",
                  "pm.collectionVariables.set('today', fmt(today));",
                  "pm.collectionVariables.set('weekEnd', fmt(new Date(today.getTime() + 6 * 86400000)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/houses/{{houseId}}/chore-assignments?from={{today}}&to={{today}}&assignee=me&includeOverdue=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "houses",
                "{{houseId}}",
                "chore-assignments"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "{{today}}"
                },
                {
                  "key": "to",
                  "value": "{{today}}"
                },
                {
                  "key": "assignee",
                  "value": "me"
                },
                {
                  "key": "includeOverdue",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Swap two turns",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/houses/{{houseId}}/chore-assignments/{{assignmentId}}/swap",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "houses",
                "{{houseId}}",
                "chore-assignments",
                "{{assignmentId}}",
                "swap"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"withAssignmentId\": {{otherAssignmentId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Mark turn done",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status DONE\", () => pm.expect(pm.response.json().assignment.status).to.eql('DONE'));"
